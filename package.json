{
  "name": "doan-java-computer-asset-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Hệ thống quản lý thiết bị máy tính (Spring Boot + React Vite)",
  "scripts": {
    "web": "node ./scripts/start-web.js",
    "start": "node ./scripts/start-web.js",
    "dev": "node ./scripts/start-web.js",
    "migrate": "node ./scripts/migrate-xampp.js",
    "db:migrate": "node ./scripts/migrate-xampp.js",
    "snapshot": "node ./scripts/snapshot-xampp.js",
    "db:snapshot": "node ./scripts/snapshot-xampp.js",
    "frontend": "npm --prefix frontend run dev",
    "backend": "cd backend && mvnw.cmd spring-boot:run",
    "backend:h2": "cd backend && mvnw.cmd spring-boot:run -Dspring-boot.run.profiles=h2"
  },
  "keywords": [
    "asset-management",
    "spring-boot",
    "react",
    "vite",
    "mysql",
    "xampp"
  ],
  "author": "",
  "license": "ISC"
}
