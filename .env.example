# Optional: copy this file to .env to use XAMPP/MySQL for both `npm run migrate`
# and `npm run web`. Leave DB_PASSWORD empty for the default XAMPP root account.
DB_URL=jdbc:mysql://localhost:3306/DoAnJava?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
FLYWAY_ENABLED=true

# VietQR transfer details. Use the bank's 6-digit BIN and account holder name.
VITE_VIETQR_BANK_BIN=
VITE_VIETQR_ACCOUNT_NUMBER=
VITE_VIETQR_ACCOUNT_NAME=